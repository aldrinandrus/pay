# Copy to .env — required for MCP + x402-axios
# Payer: this account must hold Base Sepolia USDC (faucets: https://docs.base.org/chain/tools/network-faucets)
PRIVATE_KEY=0x...

# Optional: MCP prefers ../servers/hono/.resource-server-url over this when the file exists.
# MCP_USE_ENV_RESOURCE_URL=1
RESOURCE_SERVER_URL=http://127.0.0.1:4021
# Ignored by this MCP — the tool always calls GET /weather on the Hono demo. Kept for sync-resource-url / docs only.
ENDPOINT_PATH=/weather
