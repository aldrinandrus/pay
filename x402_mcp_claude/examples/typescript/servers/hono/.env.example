# Copy to .env — ADDRESS (or X402_PAY_TO) must be non-empty
# Hosted testnet facilitator (default in code if you omit this):
FACILITATOR_URL=https://x402.org/facilitator
# Local: run examples/typescript/facilitator with PORT=3003, then FACILITATOR_URL=http://127.0.0.1:3003
NETWORK=base-sepolia
ADDRESS=0xYourBaseSepoliaWallet

# Optional (default 4021). If busy, next ports are tried up to PORT_RANGE (default 30).
# PORT=4021
# PORT_RANGE=30
# STRICT_PORT=1   # fail fast on EADDRINUSE (no fallback)
# HOST=127.0.0.1
